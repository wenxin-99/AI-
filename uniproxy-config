#!/bin/bash

# UniProxy Panel 配置管理工具
# 提供交互式配置管理：修改端口、前端路径、SSL 证书等

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# 配置文件路径
CONFIG_FILE="/opt/uniproxy-panel/config.yaml"
BACKEND_CONFIG="/opt/uniproxy-panel/backend/config.yaml"
NGINX_CONFIG="/etc/nginx/sites-available/uniproxy-panel"
FRONTEND_PATH="/var/www/uniproxy-panel"

# 打印函数
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_header() {
    clear
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                                                            ║${NC}"
    echo -e "${CYAN}║           ${MAGENTA}UniProxy Panel 配置管理工具${CYAN}                 ║${NC}"
    echo -e "${CYAN}║                                                            ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_separator() {
    echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
}

# 检查是否为 root 用户
check_root() {
    if [ "$EUID" -ne 0 ]; then
        print_error "请使用 root 用户或 sudo 运行此工具"
        exit 1
    fi
}

# 确定配置文件
get_config_file() {
    if [ -f "$CONFIG_FILE" ]; then
        echo "$CONFIG_FILE"
    elif [ -f "$BACKEND_CONFIG" ]; then
        echo "$BACKEND_CONFIG"
    else
        print_error "找不到配置文件"
        exit 1
    fi
}

# 读取当前配置
read_current_config() {
    local config_file=$(get_config_file)
    
    # 读取后端端口
    CURRENT_PORT=$(grep -E "^  port:" "$config_file" | awk '{print $2}' | head -1)
    
    # 读取前端路径
    CURRENT_FRONTEND_PATH=$(grep "root" "$NGINX_CONFIG" | grep -v "#" | awk '{print $2}' | tr -d ';' | head -1)
    
    # 检查 SSL 配置
    if grep -q "listen 443 ssl" "$NGINX_CONFIG" 2>/dev/null; then
        SSL_ENABLED="是"
        SSL_CERT=$(grep "ssl_certificate " "$NGINX_CONFIG" | grep -v "ssl_certificate_key" | awk '{print $2}' | tr -d ';' | head -1)
        SSL_KEY=$(grep "ssl_certificate_key" "$NGINX_CONFIG" | awk '{print $2}' | tr -d ';' | head -1)
    else
        SSL_ENABLED="否"
        SSL_CERT=""
        SSL_KEY=""
    fi
}

# 显示当前配置
show_current_config() {
    read_current_config
    
    echo ""
    echo -e "${CYAN}当前配置：${NC}"
    print_separator
    echo -e "  ${YELLOW}后端端口:${NC} $CURRENT_PORT"
    echo -e "  ${YELLOW}前端路径:${NC} $CURRENT_FRONTEND_PATH"
    echo -e "  ${YELLOW}SSL 状态:${NC} $SSL_ENABLED"
    if [ "$SSL_ENABLED" = "是" ]; then
        echo -e "  ${YELLOW}SSL 证书:${NC} $SSL_CERT"
        echo -e "  ${YELLOW}SSL 密钥:${NC} $SSL_KEY"
    fi
    print_separator
    echo ""
}

# 主菜单
show_main_menu() {
    print_header
    show_current_config
    
    echo -e "${CYAN}请选择操作：${NC}"
    echo ""
    echo -e "  ${GREEN}1.${NC} 修改后端端口"
    echo -e "  ${GREEN}2.${NC} 修改前端路径"
    echo -e "  ${GREEN}3.${NC} 配置 SSL 证书"
    echo -e "  ${GREEN}4.${NC} 查看系统状态"
    echo -e "  ${GREEN}5.${NC} 重启服务"
    echo -e "  ${GREEN}6.${NC} 备份配置"
    echo -e "  ${GREEN}7.${NC} 恢复配置"
    echo -e "  ${GREEN}0.${NC} 退出"
    echo ""
    echo -ne "${CYAN}请输入选项 [0-7]:${NC} "
}

# 修改后端端口
change_backend_port() {
    print_header
    echo -e "${CYAN}═══ 修改后端端口 ═══${NC}"
    echo ""
    
    read_current_config
    echo -e "${YELLOW}当前端口:${NC} $CURRENT_PORT"
    echo ""
    
    # 输入新端口
    while true; do
        echo -ne "${CYAN}请输入新端口 (1024-65535) 或按 Enter 取消:${NC} "
        read NEW_PORT
        
        # 如果为空，取消操作
        if [ -z "$NEW_PORT" ]; then
            print_info "操作已取消"
            sleep 2
            return
        fi
        
        # 验证端口号
        if ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1024 ] || [ "$NEW_PORT" -gt 65535 ]; then
            print_error "无效的端口号，请输入 1024-65535 之间的数字"
            continue
        fi
        
        # 检查端口是否被占用
        if command -v ss &> /dev/null; then
            if ss -tlnp 2>/dev/null | grep -q ":$NEW_PORT "; then
                print_warning "端口 $NEW_PORT 已被占用"
                echo -ne "${CYAN}是否继续？(y/N):${NC} "
                read CONFIRM
                if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
                    continue
                fi
            fi
        fi
        
        break
    done
    
    # 确认修改
    echo ""
    echo -e "${YELLOW}将要进行以下修改：${NC}"
    echo -e "  旧端口: ${RED}$CURRENT_PORT${NC}"
    echo -e "  新端口: ${GREEN}$NEW_PORT${NC}"
    echo ""
    echo -ne "${CYAN}确认修改？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行修改
    print_info "正在修改配置..."
    
    local config_file=$(get_config_file)
    
    # 备份配置文件
    cp "$config_file" "${config_file}.backup.$(date +%Y%m%d_%H%M%S)"
    cp "$NGINX_CONFIG" "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
    
    # 修改后端配置
    sed -i "/^server:/,/^[a-z]/ s/^  port: *[0-9]\+/  port: $NEW_PORT/" "$config_file"
    
    # 修改 Nginx 配置
    sed -i "s/127\.0\.0\.1:$CURRENT_PORT/127.0.0.1:$NEW_PORT/g" "$NGINX_CONFIG"
    
    # 测试 Nginx 配置
    if ! nginx -t 2>/dev/null; then
        print_error "Nginx 配置测试失败，正在恢复备份..."
        cp "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)" "$NGINX_CONFIG"
        sleep 3
        return
    fi
    
    # 重启服务
    print_info "重启后端服务..."
    systemctl restart uniproxy-panel
    sleep 2
    
    print_info "重新加载 Nginx..."
    systemctl reload nginx
    
    # 验证
    print_info "验证配置..."
    sleep 2
    
    if systemctl is-active --quiet uniproxy-panel; then
        if curl -s -f -m 5 "http://127.0.0.1:$NEW_PORT/api/v1/system/info" > /dev/null 2>&1; then
            print_success "端口修改成功！"
        else
            print_warning "端口已修改，但 API 暂无响应"
        fi
    else
        print_error "后端服务启动失败，请检查日志"
    fi
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 修改前端路径
change_frontend_path() {
    print_header
    echo -e "${CYAN}═══ 修改前端路径 ═══${NC}"
    echo ""
    
    read_current_config
    echo -e "${YELLOW}当前路径:${NC} $CURRENT_FRONTEND_PATH"
    echo ""
    
    # 输入新路径
    echo -ne "${CYAN}请输入新路径 (绝对路径) 或按 Enter 取消:${NC} "
    read NEW_PATH
    
    # 如果为空，取消操作
    if [ -z "$NEW_PATH" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 验证路径
    if [ ! -d "$NEW_PATH" ]; then
        print_error "路径不存在: $NEW_PATH"
        echo -ne "${CYAN}是否创建该目录？(y/N):${NC} "
        read CONFIRM
        if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
            mkdir -p "$NEW_PATH"
            print_success "目录已创建"
        else
            print_info "操作已取消"
            sleep 2
            return
        fi
    fi
    
    # 确认修改
    echo ""
    echo -e "${YELLOW}将要进行以下修改：${NC}"
    echo -e "  旧路径: ${RED}$CURRENT_FRONTEND_PATH${NC}"
    echo -e "  新路径: ${GREEN}$NEW_PATH${NC}"
    echo ""
    echo -ne "${CYAN}确认修改？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行修改
    print_info "正在修改配置..."
    
    # 备份配置文件
    cp "$NGINX_CONFIG" "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
    
    # 修改 Nginx 配置
    sed -i "s|root $CURRENT_FRONTEND_PATH;|root $NEW_PATH;|g" "$NGINX_CONFIG"
    
    # 测试 Nginx 配置
    if ! nginx -t 2>/dev/null; then
        print_error "Nginx 配置测试失败，正在恢复备份..."
        cp "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)" "$NGINX_CONFIG"
        sleep 3
        return
    fi
    
    # 复制前端文件（如果需要）
    if [ "$NEW_PATH" != "$CURRENT_FRONTEND_PATH" ]; then
        echo -ne "${CYAN}是否复制现有前端文件到新路径？(y/N):${NC} "
        read COPY_FILES
        if [ "$COPY_FILES" = "y" ] || [ "$COPY_FILES" = "Y" ]; then
            print_info "复制文件..."
            cp -r "$CURRENT_FRONTEND_PATH"/* "$NEW_PATH/"
            print_success "文件已复制"
        fi
    fi
    
    # 重新加载 Nginx
    print_info "重新加载 Nginx..."
    systemctl reload nginx
    
    print_success "前端路径修改成功！"
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 配置 SSL 证书
configure_ssl() {
    print_header
    echo -e "${CYAN}═══ 配置 SSL 证书 ═══${NC}"
    echo ""
    
    read_current_config
    echo -e "${YELLOW}当前 SSL 状态:${NC} $SSL_ENABLED"
    if [ "$SSL_ENABLED" = "是" ]; then
        echo -e "${YELLOW}当前证书:${NC} $SSL_CERT"
        echo -e "${YELLOW}当前密钥:${NC} $SSL_KEY"
    fi
    echo ""
    
    echo -e "${CYAN}请选择操作：${NC}"
    echo ""
    echo -e "  ${GREEN}1.${NC} 启用 SSL (使用现有证书)"
    echo -e "  ${GREEN}2.${NC} 启用 SSL (使用 Let's Encrypt)"
    echo -e "  ${GREEN}3.${NC} 禁用 SSL"
    echo -e "  ${GREEN}0.${NC} 返回"
    echo ""
    echo -ne "${CYAN}请输入选项 [0-3]:${NC} "
    read SSL_OPTION
    
    case $SSL_OPTION in
        1)
            configure_ssl_manual
            ;;
        2)
            configure_ssl_letsencrypt
            ;;
        3)
            disable_ssl
            ;;
        0)
            return
            ;;
        *)
            print_error "无效的选项"
            sleep 2
            ;;
    esac
}

# 手动配置 SSL
configure_ssl_manual() {
    echo ""
    echo -e "${CYAN}═══ 手动配置 SSL 证书 ═══${NC}"
    echo ""
    
    # 输入证书路径
    echo -ne "${CYAN}请输入证书文件路径 (.crt 或 .pem):${NC} "
    read CERT_PATH
    
    if [ ! -f "$CERT_PATH" ]; then
        print_error "证书文件不存在: $CERT_PATH"
        sleep 2
        return
    fi
    
    # 输入密钥路径
    echo -ne "${CYAN}请输入密钥文件路径 (.key):${NC} "
    read KEY_PATH
    
    if [ ! -f "$KEY_PATH" ]; then
        print_error "密钥文件不存在: $KEY_PATH"
        sleep 2
        return
    fi
    
    # 输入域名
    echo -ne "${CYAN}请输入域名 (例如: example.com):${NC} "
    read DOMAIN
    
    if [ -z "$DOMAIN" ]; then
        print_error "域名不能为空"
        sleep 2
        return
    fi
    
    # 确认配置
    echo ""
    echo -e "${YELLOW}SSL 配置信息：${NC}"
    echo -e "  证书: ${GREEN}$CERT_PATH${NC}"
    echo -e "  密钥: ${GREEN}$KEY_PATH${NC}"
    echo -e "  域名: ${GREEN}$DOMAIN${NC}"
    echo ""
    echo -ne "${CYAN}确认配置？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行配置
    print_info "正在配置 SSL..."
    
    # 备份配置文件
    cp "$NGINX_CONFIG" "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
    
    # 生成新的 Nginx 配置
    generate_ssl_nginx_config "$DOMAIN" "$CERT_PATH" "$KEY_PATH"
    
    # 测试 Nginx 配置
    if ! nginx -t 2>/dev/null; then
        print_error "Nginx 配置测试失败，正在恢复备份..."
        cp "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)" "$NGINX_CONFIG"
        sleep 3
        return
    fi
    
    # 重新加载 Nginx
    print_info "重新加载 Nginx..."
    systemctl reload nginx
    
    print_success "SSL 配置成功！"
    print_info "现在可以通过 https://$DOMAIN 访问"
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 使用 Let's Encrypt 配置 SSL
configure_ssl_letsencrypt() {
    echo ""
    echo -e "${CYAN}═══ 使用 Let's Encrypt 配置 SSL ═══${NC}"
    echo ""
    
    # 检查 certbot 是否安装
    if ! command -v certbot &> /dev/null; then
        print_warning "certbot 未安装"
        echo -ne "${CYAN}是否现在安装？(y/N):${NC} "
        read INSTALL_CERTBOT
        if [ "$INSTALL_CERTBOT" = "y" ] || [ "$INSTALL_CERTBOT" = "Y" ]; then
            print_info "安装 certbot..."
            apt-get update -qq
            apt-get install -y certbot python3-certbot-nginx
        else
            print_info "操作已取消"
            sleep 2
            return
        fi
    fi
    
    # 输入域名
    echo -ne "${CYAN}请输入域名 (例如: example.com):${NC} "
    read DOMAIN
    
    if [ -z "$DOMAIN" ]; then
        print_error "域名不能为空"
        sleep 2
        return
    fi
    
    # 输入邮箱
    echo -ne "${CYAN}请输入邮箱地址 (用于证书通知):${NC} "
    read EMAIL
    
    if [ -z "$EMAIL" ]; then
        print_error "邮箱不能为空"
        sleep 2
        return
    fi
    
    # 确认配置
    echo ""
    echo -e "${YELLOW}Let's Encrypt 配置信息：${NC}"
    echo -e "  域名: ${GREEN}$DOMAIN${NC}"
    echo -e "  邮箱: ${GREEN}$EMAIL${NC}"
    echo ""
    echo -e "${YELLOW}注意：${NC}"
    echo -e "  1. 请确保域名已解析到本服务器"
    echo -e "  2. 请确保 80 端口可以从外网访问"
    echo ""
    echo -ne "${CYAN}确认配置？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行配置
    print_info "正在申请证书..."
    
    certbot --nginx -d "$DOMAIN" --email "$EMAIL" --agree-tos --non-interactive
    
    if [ $? -eq 0 ]; then
        print_success "SSL 配置成功！"
        print_info "证书将自动续期"
        print_info "现在可以通过 https://$DOMAIN 访问"
    else
        print_error "SSL 配置失败，请检查域名解析和网络连接"
    fi
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 禁用 SSL
disable_ssl() {
    echo ""
    echo -e "${CYAN}═══ 禁用 SSL ═══${NC}"
    echo ""
    
    read_current_config
    
    if [ "$SSL_ENABLED" = "否" ]; then
        print_info "SSL 已经是禁用状态"
        sleep 2
        return
    fi
    
    echo -e "${YELLOW}警告：禁用 SSL 后，网站将只能通过 HTTP 访问${NC}"
    echo ""
    echo -ne "${CYAN}确认禁用 SSL？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行禁用
    print_info "正在禁用 SSL..."
    
    # 备份配置文件
    cp "$NGINX_CONFIG" "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
    
    # 生成不带 SSL 的 Nginx 配置
    generate_basic_nginx_config
    
    # 测试 Nginx 配置
    if ! nginx -t 2>/dev/null; then
        print_error "Nginx 配置测试失败，正在恢复备份..."
        cp "${NGINX_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)" "$NGINX_CONFIG"
        sleep 3
        return
    fi
    
    # 重新加载 Nginx
    print_info "重新加载 Nginx..."
    systemctl reload nginx
    
    print_success "SSL 已禁用"
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 生成带 SSL 的 Nginx 配置
generate_ssl_nginx_config() {
    local domain=$1
    local cert_path=$2
    local key_path=$3
    
    read_current_config
    local backend_port=$CURRENT_PORT
    local frontend_path=$CURRENT_FRONTEND_PATH
    
    cat > "$NGINX_CONFIG" <<EOF
# HTTP 重定向到 HTTPS
server {
    listen 80;
    server_name $domain;
    return 301 https://\$server_name\$request_uri;
}

# HTTPS 配置
server {
    listen 443 ssl http2;
    server_name $domain;

    # SSL 证书配置
    ssl_certificate $cert_path;
    ssl_certificate_key $key_path;
    
    # SSL 优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 前端静态文件
    location / {
        root $frontend_path;
        try_files \$uri \$uri/ /index.html;
        index index.html;
    }

    # API 代理到后端
    location /api {
        proxy_pass http://127.0.0.1:$backend_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # WebSocket 支持
    location /ws {
        proxy_pass http://127.0.0.1:$backend_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
}

# 生成基础 Nginx 配置（不带 SSL）
generate_basic_nginx_config() {
    read_current_config
    local backend_port=$CURRENT_PORT
    local frontend_path=$CURRENT_FRONTEND_PATH
    
    cat > "$NGINX_CONFIG" <<EOF
server {
    listen 80;
    server_name _;

    # 前端静态文件
    location / {
        root $frontend_path;
        try_files \$uri \$uri/ /index.html;
        index index.html;
    }

    # API 代理到后端
    location /api {
        proxy_pass http://127.0.0.1:$backend_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # WebSocket 支持
    location /ws {
        proxy_pass http://127.0.0.1:$backend_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
}

# 查看系统状态
show_system_status() {
    print_header
    echo -e "${CYAN}═══ 系统状态 ═══${NC}"
    echo ""
    
    read_current_config
    
    # 后端服务状态
    echo -e "${YELLOW}后端服务：${NC}"
    if systemctl is-active --quiet uniproxy-panel; then
        echo -e "  状态: ${GREEN}运行中${NC}"
        
        # 检查端口监听
        if command -v ss &> /dev/null; then
            LISTENING_PORT=$(ss -tlnp 2>/dev/null | grep uniproxy-panel | grep -oP ':\K[0-9]+' | head -1)
            if [ -n "$LISTENING_PORT" ]; then
                echo -e "  监听端口: ${GREEN}$LISTENING_PORT${NC}"
            fi
        fi
        
        # 测试 API
        if curl -s -f -m 5 "http://127.0.0.1:$CURRENT_PORT/api/v1/system/info" > /dev/null 2>&1; then
            echo -e "  API 响应: ${GREEN}正常${NC}"
        else
            echo -e "  API 响应: ${RED}异常${NC}"
        fi
    else
        echo -e "  状态: ${RED}未运行${NC}"
    fi
    
    echo ""
    
    # Nginx 服务状态
    echo -e "${YELLOW}Nginx 服务：${NC}"
    if systemctl is-active --quiet nginx; then
        echo -e "  状态: ${GREEN}运行中${NC}"
        
        # 测试代理
        if curl -s -f -m 5 "http://localhost/api/v1/system/info" > /dev/null 2>&1; then
            echo -e "  代理响应: ${GREEN}正常${NC}"
        else
            echo -e "  代理响应: ${RED}异常${NC}"
        fi
    else
        echo -e "  状态: ${RED}未运行${NC}"
    fi
    
    echo ""
    
    # 磁盘使用情况
    echo -e "${YELLOW}磁盘使用：${NC}"
    df -h / | tail -1 | awk '{print "  总容量: "$2"  已用: "$3"  可用: "$4"  使用率: "$5}'
    
    echo ""
    
    # 内存使用情况
    echo -e "${YELLOW}内存使用：${NC}"
    free -h | grep "Mem:" | awk '{print "  总内存: "$2"  已用: "$3"  可用: "$7}'
    
    echo ""
    print_separator
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 重启服务
restart_services() {
    print_header
    echo -e "${CYAN}═══ 重启服务 ═══${NC}"
    echo ""
    
    echo -e "${CYAN}请选择要重启的服务：${NC}"
    echo ""
    echo -e "  ${GREEN}1.${NC} 重启后端服务"
    echo -e "  ${GREEN}2.${NC} 重启 Nginx"
    echo -e "  ${GREEN}3.${NC} 重启所有服务"
    echo -e "  ${GREEN}0.${NC} 返回"
    echo ""
    echo -ne "${CYAN}请输入选项 [0-3]:${NC} "
    read RESTART_OPTION
    
    case $RESTART_OPTION in
        1)
            print_info "重启后端服务..."
            systemctl restart uniproxy-panel
            sleep 2
            if systemctl is-active --quiet uniproxy-panel; then
                print_success "后端服务重启成功"
            else
                print_error "后端服务重启失败"
            fi
            ;;
        2)
            print_info "重启 Nginx..."
            systemctl restart nginx
            sleep 2
            if systemctl is-active --quiet nginx; then
                print_success "Nginx 重启成功"
            else
                print_error "Nginx 重启失败"
            fi
            ;;
        3)
            print_info "重启所有服务..."
            systemctl restart uniproxy-panel
            systemctl restart nginx
            sleep 2
            if systemctl is-active --quiet uniproxy-panel && systemctl is-active --quiet nginx; then
                print_success "所有服务重启成功"
            else
                print_error "部分服务重启失败"
            fi
            ;;
        0)
            return
            ;;
        *)
            print_error "无效的选项"
            ;;
    esac
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 备份配置
backup_config() {
    print_header
    echo -e "${CYAN}═══ 备份配置 ═══${NC}"
    echo ""
    
    local backup_dir="/opt/uniproxy-panel/backups"
    local backup_name="config_backup_$(date +%Y%m%d_%H%M%S)"
    local backup_path="$backup_dir/$backup_name"
    
    # 创建备份目录
    mkdir -p "$backup_dir"
    mkdir -p "$backup_path"
    
    print_info "正在备份配置..."
    
    # 备份配置文件
    local config_file=$(get_config_file)
    cp "$config_file" "$backup_path/"
    cp "$NGINX_CONFIG" "$backup_path/"
    
    # 创建备份信息文件
    cat > "$backup_path/backup_info.txt" <<EOF
备份时间: $(date '+%Y-%m-%d %H:%M:%S')
后端配置: $(basename $config_file)
Nginx 配置: $(basename $NGINX_CONFIG)
后端端口: $CURRENT_PORT
前端路径: $CURRENT_FRONTEND_PATH
SSL 状态: $SSL_ENABLED
EOF
    
    # 压缩备份
    cd "$backup_dir"
    tar -czf "${backup_name}.tar.gz" "$backup_name"
    rm -rf "$backup_name"
    
    print_success "配置已备份到: ${backup_dir}/${backup_name}.tar.gz"
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 恢复配置
restore_config() {
    print_header
    echo -e "${CYAN}═══ 恢复配置 ═══${NC}"
    echo ""
    
    local backup_dir="/opt/uniproxy-panel/backups"
    
    if [ ! -d "$backup_dir" ]; then
        print_error "备份目录不存在"
        sleep 2
        return
    fi
    
    # 列出备份文件
    echo -e "${YELLOW}可用的备份：${NC}"
    echo ""
    
    local backups=($(ls -t "$backup_dir"/*.tar.gz 2>/dev/null))
    
    if [ ${#backups[@]} -eq 0 ]; then
        print_error "没有可用的备份"
        sleep 2
        return
    fi
    
    local i=1
    for backup in "${backups[@]}"; do
        local backup_name=$(basename "$backup" .tar.gz)
        local backup_date=$(echo "$backup_name" | grep -oP '\d{8}_\d{6}')
        local formatted_date=$(echo "$backup_date" | sed 's/\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)_\([0-9]\{2\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)/\1-\2-\3 \4:\5:\6/')
        echo -e "  ${GREEN}$i.${NC} $formatted_date"
        i=$((i+1))
    done
    
    echo ""
    echo -ne "${CYAN}请选择要恢复的备份 (1-${#backups[@]}) 或按 0 取消:${NC} "
    read BACKUP_CHOICE
    
    if [ "$BACKUP_CHOICE" = "0" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    if ! [[ "$BACKUP_CHOICE" =~ ^[0-9]+$ ]] || [ "$BACKUP_CHOICE" -lt 1 ] || [ "$BACKUP_CHOICE" -gt ${#backups[@]} ]; then
        print_error "无效的选择"
        sleep 2
        return
    fi
    
    local selected_backup="${backups[$((BACKUP_CHOICE-1))]}"
    
    # 确认恢复
    echo ""
    echo -e "${YELLOW}警告：恢复配置将覆盖当前配置${NC}"
    echo ""
    echo -ne "${CYAN}确认恢复？(y/N):${NC} "
    read CONFIRM
    
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        print_info "操作已取消"
        sleep 2
        return
    fi
    
    # 执行恢复
    print_info "正在恢复配置..."
    
    # 解压备份
    local temp_dir=$(mktemp -d)
    tar -xzf "$selected_backup" -C "$temp_dir"
    
    local backup_name=$(basename "$selected_backup" .tar.gz)
    local extracted_dir="$temp_dir/$backup_name"
    
    # 恢复配置文件
    local config_file=$(get_config_file)
    cp "$extracted_dir/$(basename $config_file)" "$config_file"
    cp "$extracted_dir/$(basename $NGINX_CONFIG)" "$NGINX_CONFIG"
    
    # 清理临时目录
    rm -rf "$temp_dir"
    
    # 测试 Nginx 配置
    if ! nginx -t 2>/dev/null; then
        print_error "Nginx 配置测试失败"
        sleep 3
        return
    fi
    
    # 重启服务
    print_info "重启服务..."
    systemctl restart uniproxy-panel
    systemctl reload nginx
    
    print_success "配置已恢复"
    
    echo ""
    echo -ne "${CYAN}按 Enter 键继续...${NC}"
    read
}

# 主程序
main() {
    check_root
    
    while true; do
        show_main_menu
        read CHOICE
        
        case $CHOICE in
            1)
                change_backend_port
                ;;
            2)
                change_frontend_path
                ;;
            3)
                configure_ssl
                ;;
            4)
                show_system_status
                ;;
            5)
                restart_services
                ;;
            6)
                backup_config
                ;;
            7)
                restore_config
                ;;
            0)
                print_header
                echo -e "${GREEN}感谢使用 UniProxy Panel 配置管理工具！${NC}"
                echo ""
                exit 0
                ;;
            *)
                print_error "无效的选项"
                sleep 1
                ;;
        esac
    done
}

# 运行主程序
main
